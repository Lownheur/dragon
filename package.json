{
  "name": "dragon",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node set-env.js && ng serve",
    "dev": "npm run start",
    "build": "node set-env.js && ng build",
    "watch": "node set-env.js && ng build --watch --configuration development",
    "test": "ng test",
    "test:verbose": "ng test --reporter=verbose",
    "test:e2e": "npx playwright test",
    "check": "npm run build && npm test && npx prettier --check \"src/**/*.{ts,html,scss}\" && npx fallow health",
    "fallow": "npx fallow health",
    "format": "npx prettier --write \"src/**/*.{ts,html,scss}\""
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@supabase/supabase-js": "^2.106.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.61.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
